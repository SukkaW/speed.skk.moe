# Speedtest targets as one JSON object, read at build time only.
# Keys are the region labels, in menu order; the first entry is the default region.
#   countries  ISO 3166-1 alpha-2 codes whose visitors default to that region (optional).
#   ping       object answered with a HEAD request, idle and under load (optional, defaults to the
#              first download object). Needs cross-origin GET; Timing-Allow-Origin gives exact timings.
#   download   one large object per host, so multi-thread spreads across connections. Needs
#              cross-origin GET; avoid content the CDN would compress on the fly.
#   upload     endpoints accepting and discarding POST bodies, or null to skip the upload phase.
SPEEDTEST_TARGETS={"Global":{"ping":"https://example.com/small-object","download":["https://cdn-a.example.com/large-object","https://cdn-b.example.com/large-object"],"upload":["https://example.com/upload-sink"]},"Mainland China":{"countries":["CN"],"download":["https://cdn-a.example.cn/large-object"],"upload":null}}
